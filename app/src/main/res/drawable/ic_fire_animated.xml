<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="64dp"
            android:height="64dp"
            android:viewportWidth="24"
            android:viewportHeight="24">

            <!-- Основное пламя -->
            <path
                android:name="flame_main"
                android:pathData="M12,23c-3.31,0-6-2.69-6-6c0,-4 6,-12 6,-12s6,8 6,12c0,3.31-2.69,6-6,6z"
                android:fillColor="#FFFFFF"/>

            <!-- Внутреннее свечение -->
            <path
                android:name="inner_glow"
                android:pathData="M12,21c-2.21,0-4-1.79-4-4c0,-2.5 4,-8 4,-8s4,5.5 4,8c0,2.21-1.79,4-4,4z"
                android:fillColor="#FFE0B2"/>
        </vector>
    </aapt:attr>

    <target android:name="flame_main">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillColor"
                android:duration="1000"
                android:valueFrom="#FFFFFF"
                android:valueTo="#FF5722"
                android:valueType="colorType"/>
        </aapt:attr>
    </target>

    <target android:name="inner_glow">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillColor"
                android:duration="1200"
                android:valueFrom="#FFFFFF"
                android:valueTo="#FF8A65"
                android:valueType="colorType"/>
        </aapt:attr>
    </target>
</animated-vector>